#!/bin/bash
# ============================================================
#  Installation SNMPv3 — simple et rapide
# ============================================================

SNMP_USER="admin"
SNMP_AUTH_PASS="Sio%2025Groupe4"
SNMP_PRIV_PASS="Sio%2025Groupe4"

# --- Root ---
[ "$EUID" -ne 0 ] && echo "❌ Exécute ce script en root." && exit 1

# --- Port 161 libre ? ---
if ss -ulnp | grep -q ":161"; then
    echo "❌ Le port 161 est déjà utilisé. Libère-le avant de continuer."
    ss -ulnp | grep ":161"
    exit 1
fi
echo "✅ Port 161 libre."

# --- Installation ---
apt-get update -q
apt-get install -y -q snmp snmpd libsnmp-dev

# --- Création utilisateur SNMPv3 ---
systemctl stop snmpd
net-snmp-create-v3-user -ro -a SHA -A "$SNMP_AUTH_PASS" -x AES -X "$SNMP_PRIV_PASS" "$SNMP_USER"

# --- Écoute sur toutes les interfaces ---
sed -i 's|^agentaddress.*|agentaddress udp:0.0.0.0:161|I' /etc/snmp/snmpd.conf

# --- Démarrage ---
systemctl restart snmpd
systemctl enable snmpd
sleep 2

# --- Vérification finale ---
if ss -ulnp | grep -q "0.0.0.0:161"; then
    echo "✅ SNMPv3 écoute sur 0.0.0.0:161"
else
    echo "❌ Le port 161 n'est pas ouvert. Lance : sudo systemctl status snmpd"
    exit 1
fi

snmpwalk -v3 -u "$SNMP_USER" -l authPriv -a SHA -A "$SNMP_AUTH_PASS" -x AES -X "$SNMP_PRIV_PASS" localhost system \
    && echo "✅ SNMPv3 opérationnel !" \
    || echo "⚠️  snmpwalk a échoué, vérifie les logs."
